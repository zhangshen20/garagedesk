# --- Owner app ---
MODEL_VISION=openbmb/MiniCPM-V-4_5     # reads photos of handwritten job cards
LABOUR_RATE_CENTS=12000                # per hour, ex GST
APPROVER_NAME=the office               # who checks invoices before they go out
APPROVER_PHONE=+61400000009            # gets the approve link by SMS
AUTO_APPROVE_INVOICE_UNDER_CENTS=0     # inc GST; 0 = every invoice is approved first
APP_SECRET=change-me                   # signs the approve links
