# --- Nebius Token Factory (required for live Nemotron; leave empty for demo/mock mode) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA Nemotron tiers (defaults shown)
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
# auto | nebius | mock
LLM_MODE=auto

# --- Optional integrations ---
TAVILY_API_KEY=            # live parts price search
TWILIO_ACCOUNT_SID=        # real SMS + phone calls; otherwise messages land in the Outbox page
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- The shop ---
SHOP_NAME=Sunshine Auto Care
SHOP_TRADING_NAME=Sunshine Auto Care
SHOP_ABN=12 345 678 901
SHOP_ADDRESS=Whitehill Ave, Sunshine North VIC 3020
SHOP_PHONE=(03) 9000 0000
SHOP_EMAIL=desk@sunshineautocare.example
SHOP_HOURS=Mon-Sat 8:00am-5:30pm
SHOP_TIMEZONE=Australia/Melbourne
BAYS=3
OWNER_NAME=Shen
OWNER_PHONE=+61400000000
